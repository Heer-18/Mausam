# Single or Multiple Gemini API Keys (comma-separated or numbered GEMINI_API_KEY_1, GEMINI_API_KEY_2)
# When one key hits rate limit / quota, Mausam AI automatically rotates to the next available key!
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=your_primary_gemini_api_key_here

OPENWEATHER_API_KEY=your_openweather_api_key_here
API_BASE_URL=http://127.0.0.1:8000
